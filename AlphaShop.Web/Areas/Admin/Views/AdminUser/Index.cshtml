@model IEnumerable<ApplicationUser>

<partial name="_Notification" />
<header class="page-header page-header-dark bg-gradient-custom-to-custom pb-10 is-rtl">
    <div class="container-xl px-4">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto mt-4">
                    <h1 class="page-header-title">
                        <i class="ms-1 me-1 bx bx-filter"></i>
                        جدول
                    </h1>
                    <div class="page-header-subtitle">لورم ایپسوم متن ساختگی با تولید سادگی نامفهوم در صنعت چاپ است.</div>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="container-xl px-4 mt-n10 is-rtl">
    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between">
                <div>جدول ادمین ها</div>
                <div><a class="btn btn-primary" asp-area="Admin" asp-controller="AdminUser" asp-action="Create">ایجاد ادمین <i class="bx bx-plus-circle ps-2"></i></a></div>
            </div>
        </div>
        <div class="card-body">

            <table id="datatablesSimple">
                <thead>
                    <tr>
                        <td>#</td>
                        <th>نام</th>
                        <th class="col-2">شماره تلفن</th>
                        <th>وصعیت قفل</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <td>#</td>
                        <th>نام</th>
                        <th class="col-2">شماره تلفن</th>
                        <th>وصعیت قفل</th>
                        <th>عملیات</th>
                    </tr>
                </tfoot>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td>@item.PhoneNumber</td>
                            <td><span class="badge @(item.LockoutEnd > DateTime.UtcNow ? "bg-danger" : "bg-success")">@(item.LockoutEnd > DateTime.UtcNow ? "قفل شده" : "قفل نشده")</span></td>

                            <td>
                                <form asp-area="Admin" asp-controller="AdminUser" asp-action="ToggleLock" method="post">
                                    <input type="hidden" name="userId" value="@item.Id" />
                                <button class="btn @(item.LockoutEnd > DateTime.UtcNow ? "btn-success" : "btn-danger")">@(item.LockoutEnd > DateTime.UtcNow ? "خارج کردن از قفل" : "قفل کردن")</button>
                                </form>
                                </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>