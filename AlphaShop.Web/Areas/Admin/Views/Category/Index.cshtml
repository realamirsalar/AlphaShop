@model List<Category>
@{
    int i = 1;
}
<header class="page-header page-header-dark bg-gradient-custom-to-custom pb-10 is-rtl">
    <div class="container-xl px-4">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto mt-4">
                    <h1 class="page-header-title">
                        <i class="ms-1 me-1 bx bx-filter"></i>
                        جدول
                    </h1>
                    <div class="page-header-subtitle">لورم ایپسوم متن ساختگی با تولید سادگی نامفهوم در صنعت چاپ است.</div>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="container-xl px-4 mt-n10 is-rtl">
    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between">
                <div>جدول دسته بندی ها</div>
                <div><a class="btn btn-primary" asp-area="Admin" asp-controller="Category" asp-action="Create">ایجاد دسته بندی <i class="bx bx-plus-circle ps-2"></i></a></div>
            </div>
        </div>
        <div class="card-body">

            <table id="datatablesSimple">
                <thead>
                    <tr>
                        <td>#</td>
                        <th>نام</th>
                        <th>اولویت نمایش</th>
                        <th>عملیات</th>

                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th>نام</th>
                        <th>اولویت نمایش</th>
                        <th>عملیات</th>
                    </tr>
                </tfoot>
                <tbody>
                    @foreach(var category in Model)
                    {
                        <tr>
                        <td>@i</td>
                        <td>@category.Name</td>
                        <td>@category.DisplayOrder</td>
                        <td>
                                <a class="btn btn-warning" asp-area="Admin" asp-controller="Category" asp-action="Update" asp-route-id="@category.Id">آپدیت</a>
                                <a class="btn btn-danger" asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id">حذف</a>
                        </td>
                           
                        </tr> i++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>