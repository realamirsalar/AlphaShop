
@model List<OrderListDTO>
@{
    int i = 1;
    ViewBag.Title = "سفارشات";
}
<partial name="_Notification" />
<header class="page-header page-header-dark bg-gradient-custom-to-custom pb-10 is-rtl">
    <div class="container-xl px-4">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto mt-4">
                    <h1 class="page-header-title">
                        <i class="ms-1 me-1 bx bx-filter"></i>
                        جدول
                    </h1>
                    <div class="page-header-subtitle">لورم ایپسوم متن ساختگی با تولید سادگی نامفهوم در صنعت چاپ است.</div>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="container-xl px-4 mt-n10 is-rtl">
    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between">
                <div>جدول سفارش ها</div>
            </div>
        </div>
        <div class="card-body">

            <table id="datatablesSimple">
                <thead>
                    <tr>
                        <td>#</td>
                        <th>شماره</th>
                        <th>نام سفارش دهنده</th>
                        <th class="col-2">جمع کل سفارشات</th>
                        <th>تعداد اقلام </th>
                        <th>تاریخ </th>
                        <th>وضعیت سفارش</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <td>#</td>
                        <th>شماره</th>
                        <th>نام سفارش دهنده</th>
                        <th class="col-2">جمع کل سفارشات</th>
                        <th>تعداد اقلام </th>
                        <th>تاریخ </th>
                        <th>وضعیت سفارش</th>
                    </tr>
                </tfoot>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.Name</td>
                            <td>@item.TotalCost.ToString("N0") تومان</td>
                            <td>@item.Count</td>
                            <td>@item.Date</td>
                            <td>@item.Status</td>

                            <td>
                                <a class="btn btn-warning" asp-area="Admin" asp-controller="Orders" asp-action="Update" asp-route-id="@item.Id">آپدیت</a>
                                <a class="btn btn-primary" asp-area="Admin" asp-controller="Orders" asp-action="Detail" asp-route-id="@item.Id">جزییات</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>