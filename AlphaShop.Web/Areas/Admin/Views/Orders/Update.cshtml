@using AlphaShop.Web.ViewModels.Order
@model UpdateOrderVM

<header class="page-header page-header-dark bg-gradient-primary-to-secondary mb-4">
    <div class="container-xl px-4">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto mt-4">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="bx bx-file-blank"></i></div>
                        ویرایش سفارش
                    </h1>
                    <div class="page-header-subtitle">اینجا میتوانید یک سفارش را ویرایش کنید.</div>
                </div>
            </div>
        </div>
    </div>
</header>
<div class="container-xl px-4">
    <div class="row">
        <div class="col-lg-12">
            <div id="solid">
                <div class="card mb-4">
                    <div class="card-header">ویرایش سفارش</div>
                    <div class="card-body">
                        <div class="sbp-preview">
                            <div class="sbp-preview-content">
                                <form method="post" enctype="multipart/form-data">
                                    <div class="mb-3">
                                        <input type="hidden" asp-for="Id" value="@Model.Id" />
                                        <label asp-for="RefPostId">کد پیگری مرسوله پستی</label>
                                        <input asp-for="RefPostId" class="form-control form-control-solid" placeholder="لطفا نام سفارش را وارد کنید...">
                                        <span asp-validation-for="RefPostId" class="text-danger"></span>
                                    </div>
                                  
                                    <div class="mb-3">
                                        <label class="pb-3" asp-for="Status">انتخاب وضعیت سفارش</label>
                                        <select asp-for="Status" asp-items="Model.Statuses" class="form-select" aria-label="Default select example">
                                            <option value="" selected>--انتخاب وضعیت سفارش--</option>
                                        </select>
                                    </div>

                                    <button class="btn btn-success"><i class="bx bx-check-circle"></i>ثبت اطلاعات</button>
                                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-danger">بازگشت</a>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section AdminScripts {
    <partial name="_ValidationScriptsPartial" />
    
}