@model LoginVM
<div class="site-breadcrumb">
	<div class="site-breadcrumb-bg" style="background: url(/assets/img/breadcrumb/01.jpg)">
	</div>
	<div class="container">
		<div class="site-breadcrumb-wrap">
			<h4 class="breadcrumb-title">
				ثبت نام کنید
			</h4>
			<ul class="breadcrumb-menu">
				<li>
					<a href="index-2.html">
						<i class="far fa-home">
						</i>
						خانه
					</a>
				</li>
				<li class="active">
					ثبت نام کنید
				</li>
			</ul>
		</div>
	</div>
</div>
<div class="login-area py-100">
	<div class="container">
		<div class="col-md-5 mx-auto">
			<div class="login-form">
				<div class="login-header">
					<img alt="" src="~/assets/img/logo/logo.png" />
					<p>
						حساب mocart رایگان خود را ایجاد کنید
					</p>
				</div>
				<div asp-validation-summary="All" class="text-danger"></div>
				<form asp-action="Login" method="post">
					<div class="form-group">
						<label asp-for="PhoneNumber">
						</label>
						<input asp-for="PhoneNumber" class="form-control" placeholder="شماره موبایل شما" />
						<span class="text-danger" asp-validation-for="PhoneNumber"></span>
					</div>
					<div class="form-group">
						<label asp-for="Password">
							رمز
						</label>
						<input asp-for="Password" class=" form-control" placeholder="رمز عبور شما" type="password" />
						<span class="text-danger" asp-validation-for="Password"></span>
					</div>
					<div class="d-flex justify-content-between mb-4">
						<div class="form-check">
							<input asp-for="RemeberMe" class="" id="remember" type="checkbox">
							<label  class="form-check-label" for="remember">
								مرا به خاطر بسپار
							</label>
						</div>
					</div>
					<div class="d-flex align-items-center">
						<button class="theme-btn" type="submit">
							<i class="far fa-paper-plane">
							</i>
							ثبت نام کنید
						</button>
					</div>

				</form>
				<div class="login-footer">
					<p>
						حساب کاربری ندارید؟
						<a asp-controller="Auth" asp-action="Register">
							ثبت نام کنید
						</a>
					</p>
					
				</div>
			</div>
		</div>
	</div>
</div>