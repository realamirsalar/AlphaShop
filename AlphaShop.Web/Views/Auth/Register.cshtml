
@model RegisterVM

<div class="site-breadcrumb">
	<div class="site-breadcrumb-bg" style="background: url(/assets/img/breadcrumb/01.jpg)">
	</div>
	<div class="container">
		<div class="site-breadcrumb-wrap">
			<h4 class="breadcrumb-title">
				ثبت نام کنید
			</h4>
			<ul class="breadcrumb-menu">
				<li>
					<a href="index-2.html">
						<i class="far fa-home">
						</i>
						خانه
					</a>
				</li>
				<li class="active">
					ثبت نام کنید
				</li>
			</ul>
		</div>
	</div>
</div>
<!-- breadcrumb end -->
<!-- register area -->
<div class="login-area py-100">
	<div class="container">
		<div class="col-md-5 mx-auto">
			<div class="login-form">
				<div class="login-header">
					<img alt="" src="~/assets/img/logo/logo.png" />
					<p>
						حساب mocart رایگان خود را ایجاد کنید
					</p>
				</div>
				<div asp-validation-summary="All" class="text-danger"></div>
				<form method="post">
					<div class="form-group">
						<label asp-for="Name">
							نام کامل
						</label>
						<input asp-for="Name" class="form-control" placeholder="نام شما" type="text" />
						<span class="text-danger" asp-validation-for="Name"></span>
					</div>
					<div class="form-group">
						<label asp-for="PhoneNumber">
						</label>
						<input asp-for="PhoneNumber" class="form-control" placeholder="شماره موبایل شما" />
						<span class="text-danger" asp-validation-for="PhoneNumber"></span>
					</div>
					<div class="form-group">
						<label asp-for="Password">
							رمز
						</label>
						<input asp-for="Password" class=" form-control" placeholder="رمز عبور شما" type="password" />
						<span class="text-danger" asp-validation-for="Password"></span>
					</div>
					
					<div class="form-group">
						<label asp-for="ConfirmPassword">
							تایید رمز عبور
						</label>
						<input asp-for="ConfirmPassword" class=" form-control" placeholder="تایید رمز عبور شما" type="password" />
						<span class="text-danger" asp-validation-for="ConfirmPassword"></span>
					</div>
					
					<div class="d-flex align-items-center">
						<button class="theme-btn" type="submit">
							<i class="far fa-paper-plane">
							</i>
							ثبت نام کنید
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}