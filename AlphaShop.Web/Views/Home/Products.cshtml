@model List<Product>

	@{
	int pageCount = ViewBag.PageCount;
	int page = ViewBag.Page;
	var i = page;
	var j = 1;
	}
	<!-- breadcrumb -->
	<div class="site-breadcrumb">
		<div class="site-breadcrumb-bg" style="background: url(/assets/img/breadcrumb/01.jpg)">
		</div>
		<div class="container">
			<div class="site-breadcrumb-wrap">
				<h4 class="breadcrumb-title">
					فروشگاه گرید دو
				</h4>
				<ul class="breadcrumb-menu">
					<li>
						<a href="index.html">
							<i class="far fa-home">
							</i>
							خانه
						</a>
					</li>
					<li class="active">
						فروشگاه 
						</li>
				</ul>
			</div>
		</div>
	</div>
	<!-- breadcrumb end -->
	<!-- shop-area -->
	<div class="shop-area2 py-100">
		<div class="container">
			<div class="row g-4">
				<div class="col-lg-9">
					<div class="shop-item-wrap item-2">
						<div class="row g-4">
							@foreach(var item in Model)
						{

							<div class="col-md-6 col-lg-4">
								<div class="product-item" dir="rtl">
									<div class="product-img">
										@if(item.Quntity ==0 )
										{
												<span class="type oos">
													موجود نیست
												</span>
										}
										
										
										<a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@item.Id">
											<img alt="@item.Name" src="@item.ImageUrl" />
										</a>
									</div>
									<div class="product-content">
										<h3 class="product-title">
											<a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@item.Id">
												@item.Name
											</a>
										</h3>
										
										<div class="product-bottom">
											<div class="product-price">
												<span>
													@if(item.OldPrice > 0)
													{
														<del>@item.OldPrice </del>
														<span>@item.Price.ToString("N0") تومان</span>
															 
													}
												</span>
											</div>
											<a aria-label="اضافه به سبد خرید" asp-controller="Home" asp-action="ProductDetails" asp-route-id="@item.Id" class="product-cart-btn" data-bs-original-title="اضافه به سبد خرید" data-bs-placement="left" data-tooltip="tooltip">
												<i class="far fa-shopping-bag">
												</i>
											</a>
										</div>
									</div>
								</div>
							</div>
						}
					</div>
					</div>
					<!-- pagination -->
					<div class="pagination-area mt-50">
						<div aria-label="Page navigation example">
							<ul class="pagination">
							@if (page != 1)

							{
                                <li class="page-item">
									<a aria-label="Previous" class="page-link" href="@Url.Action("Products", "Home", new { page = page - 1 })">
										<span aria-hidden="true">
											<i class="far fa-arrow-right">
											</i>
										</span>
									</a>
								</li>
							}

							@if (i < 3)
							{
								i = 1;
								while (j <= 3 && i <= pageCount)
								{
									if (page == i)

									{
										<li class="page-item active">
											<a class="page-link" href="@Url.Action("Products", "Home", new { page = i })">
												@i
											</a>
										</li>
									}
									else
									{
										<li class="page-item ">
											<a class="page-link" href="@Url.Action("Products", "Home", new { page = i })">
												@i
											</a>
										</li>
									}

									i++;
									j++;
								}
								if (pageCount > 3)
								{
									<li class="page-item">
										<span class="page-link">
											...
										</span>
									</li>
									<li class="page-item">
										<a class="page-link" href="@Url.Action("Products", "Home", new { page = pageCount })">
											@pageCount
										</a>
									</li>
								}

							}
							else
							{
								i = i - 2;

								while (j <= 5 && i <= pageCount)
								{
									if (page == i)

									{
										<li class="page-item active">
											<a class="page-link" href="@Url.Action("Products", "Home", new { page = i })">
												@i
											</a>
										</li>
									}
									else
									{
										<li class="page-item ">
											<a class="page-link" href="@Url.Action("Products", "Home", new { page = i })">
												@i
											</a>
										</li>
									}

									i++;
									j++;
								}
							}
							@if (pageCount != 1 && pageCount != 0 && page != pageCount)
							{
								<li class="page-item">
									<a aria-label="Next" class="page-link" href="@Url.Action("Products", "Home", new { page = page + 1 })">
										<span aria-hidden="true">
											<i class="far fa-arrow-left">
											</i>
										</span>
									</a>
								</li>
							}
							</ul>
						</div>
					</div>
					<!-- pagination end -->
