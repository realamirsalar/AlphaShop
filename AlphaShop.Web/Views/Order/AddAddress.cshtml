
@model AddressVM

<!-- breadcrumb -->
<div class="site-breadcrumb">
	<div class="site-breadcrumb-bg" style="background: url(/assets/img/breadcrumb/01.jpg)">
	</div>
	<div class="container">
		<div class="site-breadcrumb-wrap">
			<h4 class="breadcrumb-title">
				سبد خرید
			</h4>
			<ul class="breadcrumb-menu">
				<li>
					<a href="index-2.html">
						<i class="far fa-home">
						</i>
						خانه
					</a>
				</li>
				<li class="active">
					سبد خرید
				</li>
			</ul>
		</div>
	</div>
</div>
<!-- breadcrumb end -->
<!-- shop cart -->
<div class="shop-cart py-100">
	<div class="container">
		<div class="shop-cart-wrap">
			<div class="row">
				<div class="col-lg-12">
					<div class="user-wrapper">
						<div class="row">
							<div class="col-lg-12">
								<div class="user-card">
									<div class="user-card-header">
										<h4 class="user-card-title">
											اضافه کردن آدرس جدید
										</h4>
										<div class="user-card-header-right">
											<a class="theme-btn" href="address-list.html">
												<span class="fas fa-arrow-left" style="transform: rotate(180deg);">
												</span>
												لیست آدرس
											</a>
										</div>
									</div>
									<div class="user-form">
										<form method="post">
											<div class="row">
												
												<div class="col-md-12">
													<div class="form-group">
														<label asp-for="State"> 
														</label>
														<input asp-for="State" class="form-control" placeholder="استان" type="text">
													</div>
												</div>
												<div class="col-md-6">
													<div class="form-group">
														<label asp-for="City">
															شهر
														</label>
														<input asp-for="City" class="form-control" placeholder="شهر	" type="text">
													</div>
												</div>
												<div class="col-md-6">
													<div class="form-group">
														<labe asp-for="PostalCode" >
															کد پستی
														</labe>
														<input asp-for="PostalCode" class="form-control" placeholder="آدرس دقیق" type="text" />
													</div>
												</div>
												<div class="col-md-12">
													<div class="form-group">
														<label asp-for="StreetAddress">
															آدرس
														</label>
														<textarea asp-for="StreetAddress" class="form-control" placeholder="آدرس کامل شما" type="text"></textarea>
													</div>
												</div>
											</div>
											<button class="theme-btn" type="submit">
												<span class="far fa-save">
												</span>
												رفتن به درگاه پرداخت
											</button>
										</form>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>