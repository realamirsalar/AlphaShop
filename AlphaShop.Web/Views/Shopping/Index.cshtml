@model List<ShoppingCart>
@{
	int sum = 0;
}
	<!-- breadcrumb -->
	<div class="site-breadcrumb">
		<div class="site-breadcrumb-bg" style="background: url(assets/img/breadcrumb/01.jpg)">
		</div>
		<div class="container">
			<div class="site-breadcrumb-wrap">
				<h4 class="breadcrumb-title">
					سبد خرید
				</h4>
				<ul class="breadcrumb-menu">
					<li>
						<a href="index-2.html">
							<i class="far fa-home">
							</i>
							خانه
						</a>
					</li>
					<li class="active">
						سبد خرید
					</li>
				</ul>
			</div>
		</div>
	</div>
	<!-- breadcrumb end -->
	<!-- shop cart -->
	<div class="shop-cart py-100">
		<div class="container">
			<div class="shop-cart-wrap">
				<div class="row">
					<div class="col-lg-8">
						<div class="cart-table">
							<div class="table-responsive">
								<table class="table">
									<thead>
										<tr>
											<th>
												تصویر
											</th>
											<th>
												نام محصول
											</th>
											<th>
												قیمت
											</th>
											<th>
												مقدار
											</th>
											<th>
												مجموع
											</th>
											<th>
											</th>
										</tr>
									</thead>
									<tbody>
										@foreach(var item in Model)
									{
										<tr>
											<td>
												<div class="shop-cart-img">
													<a href="#">
														<img alt="" src="@item.Product.ImageUrl">
													</a>
												</div>
											</td>
											<td>
												<div class="shop-cart-content">
													<h5 class="shop-cart-name">
														<a href="#">
															@item.Product.Name
														</a>
													</h5>
												</div>
											</td>
											<td>
												<div class="shop-cart-price">
													<span>
														@item.Product.Price.ToString("N0") تومان
													</span>
												</div>
											</td>
											<td>
												<div class="shop-cart-qty">
													<form class="d-inline" asp-action="Minus">
														<input type="hidden" name="cartId" value="@item.Id" />
														<button type="submit" class="">
															<i class="fal fa-minus">
															</i>
														</button>
													</form>
													<input class="quantity" disabled="" type="text" value="@item.Count">
													<form class="d-inline" asp-action="Plus">
														<input type="hidden" name="cartId" value="@item.Id" />
														<button type="submit" class="">
															<i class="fal fa-plus">
															</i>
														</button>
													</form>
													
												</div>
											</td>
											<td>
												<div class="shop-cart-subtotal">
													<span>
														@((item.Product.Price * item.Count).ToString("N0")) تومان
													</span>
												</div>
											</td>
											<td>
												<form asp-action="Remove">
													<input type="hidden" name="cartId" value="@item.Id" />
													<button class="shop-cart-remove" type="submit">
														<i class="far fa-times">
														</i>
													</button>
												</form>
												
											</td>
										</tr>
										@(sum += (item.Product.Price * item.Count))
									}
								</tbody>
								</table>
							</div>
						</div>
						<div class="shop-cart-footer">
							<div class="row">
								<div class="col-md-7 col-lg-6">
									<div class="shop-cart-coupon">
										<div class="form-group">
											<input class="form-control" placeholder="کلید را وارد کنید..." type="text">
											<button class="theme-btn" type="submit">
												کوپن را اعمال کنید
											</button>
										</div>
									</div>
								</div>
								<div class="col-md-5 col-lg-6">
									<div class="shop-cart-btn text-md-end">
										<a class="theme-btn" asp-controller="Home" asp-action="Products">
											<span class="fas fa-arrow-right" style="transform: rotate(0);">
											</span>
											به خرید ادامه دهید
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-4">
						<div class="shop-cart-summary">
							<h5>
								خلاصه سبد خرید
							</h5>
							<ul>
								<li>
									<strong>
										مجموع ناخالص:
									</strong>
									<span>
										@sum.ToString("N0")
									</span>
								</li>
								
								<li>
									<strong>
										حمل و نقل:
									</strong>
									<span>
										رایگان
									</span>
								</li>
								
								<li class="shop-cart-total">
									<strong>
										مجموع:
									</strong>
								<span>
									@sum.ToString("N0")
									</span>
								</li>
							</ul>
							<div class="text-end mt-40">
								<a class="theme-btn" asp-controller="Order" asp-action="AddAddress">
									تکمیل سفارش
									<i class="fas fa-arrow-left">
									</i>
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>